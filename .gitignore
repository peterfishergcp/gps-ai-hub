.env
.env.*
!.env.example
*.env
*.key
*.pem
*.p12
*.pfx
*.asc
*credential*.json
*credentials*.json
*service_account*.json
*sa_key*.json
*gcp_key*.json
adc.json
id_rsa
id_ed25519
.msal_token_cache.bin
.purview_token_cache.json
*token_cache*.json

# Cloud & Auth Tokens
.gcloud/
.aws/
.azure/
.config/
.npmrc

# Python Dependencies & Virtual Envs
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.venv

# Node.js & Web Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
dist/
build/

# Terraform & Infrastructure State
/terraform/
*.tfstate
*.tfstate.*
.terraform/

# Zip & Heavy Archives
*.zip
*.tar.gz
*.tgz
*.rar

# Databases & Logs
*.db
*.sqlite
*.sqlite3
*.log

# OS & Editor Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/

# Local Scratch & Temporary Directories
