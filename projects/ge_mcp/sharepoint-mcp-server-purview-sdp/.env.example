# Google Cloud & SDP Content Policy Settings
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GE_LOCATION=us
SERVICE_NAME=sharepoint-mcp-server-purview-sdp
SERVICE_ACCOUNT_EMAIL=sp-purview-sdp-sa@your-gcp-project-id.iam.gserviceaccount.com
SDP_CONTENT_POLICY=projects/your-gcp-project-id/locations/us/contentPolicies/your-sdp-policy-id

# Microsoft Entra ID OAuth 2.0 Credentials (Secret mounted via Cloud Secret Manager)
MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_SECRET_NAME=ms-graph-client-secret
SHAREPOINT_INSTANCE_URL=https://your-org-placeholder.sharepoint.com

# Runtime Options
PORT=8080
ENABLE_WRITE_TOOLS=true
ENABLE_BUILTIN_SDP_DETECTORS=true
ALLOW_APP_CREDENTIALS=false
