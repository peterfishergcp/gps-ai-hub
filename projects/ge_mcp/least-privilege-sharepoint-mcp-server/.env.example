# ============================================================================
# Microsoft Entra ID (Azure AD) App Registration Credentials
# Required Entra ID Permission: Microsoft Graph -> Application -> Sites.Selected
# Site Role Assignment: "read" on each site in ALLOWED_SHAREPOINT_SITES
# ============================================================================
MS_GRAPH_TENANT_ID=your-entra-tenant-id
MS_GRAPH_CLIENT_ID=your-least-privilege-app-client-id
MS_GRAPH_CLIENT_SECRET=your-least-privilege-app-client-secret

# Optional default SharePoint hostname (used when short site names or /sites/... paths are passed)
SHAREPOINT_HOSTNAME=your-tenant.sharepoint.com

# Comma-separated list of specific SharePoint sites this MCP server is allowed to query.
# Supported formats per entry:
#   - Full URL:         https://your-tenant.sharepoint.com/sites/Finance
#   - Graph site path:  your-tenant.sharepoint.com:/sites/Finance
#   - Relative path:    /sites/Finance (requires SHAREPOINT_HOSTNAME)
#   - Graph site ID:    your-tenant.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000
ALLOWED_SHAREPOINT_SITES=https://your-tenant.sharepoint.com/sites/Finance,https://your-tenant.sharepoint.com/sites/HR

# Optional Google Cloud Project ID for Cloud Run deployment
GCP_PROJECT=<INSERT_YOUR_PROJECT_ID>

# Optional security & server settings
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_CORS_ORIGINS=https://console.cloud.google.com,https://vertexaisearch.cloud.google.com
PORT=3000
HOST=127.0.0.1
