# Google Cloud Deployment Settings
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=least-privilege-sharepoint-mcp-server
SERVICE_ACCOUNT_EMAIL=least-priv-sp-sa@your-gcp-project-id.iam.gserviceaccount.com

# Microsoft Entra ID Least-Privilege (Sites.Selected) Credentials
MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_SECRET_NAME=ms-graph-client-secret

# Optional Separate Connector OAuth Credentials (defaults to MS_GRAPH_CLIENT_ID / SECRET)
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_TOKEN_SIGNING_SECRET=

# Mandatory Explicit Site Allowlist (Comma-Separated Site URLs)
SHAREPOINT_HOSTNAME=your-org-placeholder.sharepoint.com
ALLOWED_SHAREPOINT_SITES=https://your-org-placeholder.sharepoint.com/sites/Finance,https://your-org-placeholder.sharepoint.com/sites/HR

# Runtime Options
PORT=8080
ALLOW_APP_CREDENTIALS=true
