# Google Cloud Project & Vertex AI Configuration
PROJECT_ID=your-gcp-project-id
REGION=global
DEFAULT_MODEL=claude-sonnet-4-6

# Dedicated Least-Privilege Cloud Run Runtime Service Account
SERVICE_ACCOUNT_EMAIL=vertex-claude-mcp-sa@your-gcp-project-id.iam.gserviceaccount.com

# Optional: Set ALLOW_ADC_FALLBACK=true ONLY when Cloud Run IAM (--no-allow-unauthenticated) is enforced
ALLOW_ADC_FALLBACK=false

# Optional: Comma-separated allowed CORS origins
ALLOWED_CORS_ORIGINS=https://vertexaisearch.cloud.google.com,https://console.cloud.google.com
