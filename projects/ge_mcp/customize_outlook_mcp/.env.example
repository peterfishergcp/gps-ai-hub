# Google Cloud Deployment Settings
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=outlook-mcp-server
SERVICE_ACCOUNT_EMAIL=outlook-mcp-sa@your-gcp-project-id.iam.gserviceaccount.com

# Microsoft Entra ID App Registration (Secret stored in Cloud Secret Manager for Cloud Run)
MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_SECRET_NAME=ms-graph-client-secret

# Optional: Only enable if using app-only mailbox access instead of delegated Entra OAuth 2.0
ALLOW_APP_CREDENTIALS=false
OUTLOOK_USER_ID=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_TOKEN_SIGNING_SECRET=

# Optional: Comma-separated exact OAuth redirect URIs & CORS origins
ALLOWED_OAUTH_REDIRECT_URIS=https://vertexaisearch.cloud.google.com/console/oauth/default_oauth.html
ALLOWED_CORS_ORIGINS=https://vertexaisearch.cloud.google.com,https://console.cloud.google.com
