# Microsoft Entra ID & OAuth 2.0 Configuration
MS_TENANT_ID="<YOUR_ENTRA_TENANT_ID>"
MS_CLIENT_ID="<YOUR_ENTRA_OAUTH_CLIENT_ID>"
MS_CLIENT_SECRET="<YOUR_ENTRA_OAUTH_CLIENT_SECRET>"
MS_TEST_USER="user@<YOUR_TENANT_DOMAIN>.onmicrosoft.com"
MS_TEST_PASSWORD="<YOUR_TEST_USER_PASSWORD>"

# SharePoint Online Library & Document Identifiers
MS_SHAREPOINT_SITE_NAME="<YOUR_SHAREPOINT_SITE>"
MS_SHAREPOINT_DRIVE_ID="<YOUR_SHAREPOINT_DRIVE_ID>"

# Scenario A: Allowed Document & Purview Sensitivity Label (Confidential - RMS)
MS_ALLOWED_ITEM_ID="<YOUR_ALLOWED_DOCX_ITEM_ID>"
MS_ALLOWED_LABEL_ID="<YOUR_ALLOWED_PURVIEW_LABEL_GUID>"

# Scenario B: Blocked Document & Purview Sensitivity Label (SOC - Restricted Block)
MS_RESTRICTED_ITEM_ID="<YOUR_RESTRICTED_DOCX_ITEM_ID>"
MS_RESTRICTED_LABEL_ID="<YOUR_RESTRICTED_PURVIEW_LABEL_GUID>"

# Optional: Path to App-Only X.509 Certificate & Key for Non-Owner Label Assignment
MS_APP_CERT_PATH=".app_cert.pem"
MS_APP_KEY_PATH=".app_key.pem"
