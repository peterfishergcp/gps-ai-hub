        "mode": "static",
        "value": "0",
        "delta": "Auto Spam-recovery check active",
        "tone": "gold"
      }
    ],
    "widgets": [
      {
        "id": "w-stream-volume",
        "title": "Reports Triaged by Regional Category",
        "subtitle": "Incoming operational reports evaluated by written threshold rules",
        "chartType": "bar",
        "span": 6,
        "groupBy": "category",
        "metricField": "reportCount",
        "format": "integer",
        "visible": true
      },
      {
        "id": "w-disposition-mix",
        "title": "Triage Disposition Breakdown",
        "subtitle": "Routine archive vs. immediate director alerts and fail-safe holds",
        "chartType": "donut",
        "span": 6,
        "groupBy": "disposition",
        "metricField": "reportCount",
        "format": "integer",
        "visible": true
      },
      {
        "id": "w-daily-latency",
        "title": "Median Processing & Alert Latency (Minutes)",
        "subtitle": "End-to-end minutes from inbox arrival to rule classification & Spam verification",
        "chartType": "line",
        "span": 12,
        "seriesKey": "weeklyTimeline",
        "format": "decimal_min",
        "visible": true
      },
      {
        "id": "w-triage-log",
        "title": "Operational Rule Classification Summary (Synthetic Audit View)",
        "subtitle": "Written director rules applied to Field Safety and Facility Operations streams",
        "chartType": "table",
        "span": 12,
        "columns": [
          {
            "key": "batchDate",
            "label": "Date"
          },
          {
            "key": "stream",
            "label": "Stream"
          },
          {
            "key": "category",
            "label": "Incident Category"
          },
          {
            "key": "disposition",
            "label": "Disposition"
          },
          {
            "key": "reportCount",
            "label": "Reports"
          },
          {
            "key": "alertCount",
            "label": "Alerts"
          },
          {
            "key": "slaMinutes",
            "label": "Latency (min)"
          },
          {
            "key": "gmailLabel",
            "label": "Target Label"
          }
        ],
        "visible": true
      }
    ],
    "queries": {
      "records": "SELECT batch_date AS batchDate, stream, category, disposition, report_count AS reportCount, alert_count AS alertCount, sla_minutes AS slaMinutes, gmail_label AS gmailLabel FROM `public_ops_analytics.incident_triage_summary` WHERE (@stream = 'All' OR stream = @stream) ORDER BY batch_date DESC LIMIT 250"
    }
  },
