{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "AGY Design Studio Preview",
  "description": "Serverless visual preview panel for Public Sector Dashboards, 16:9 Slide Decks, and Branded Flyers (renders natively via srcdoc with 1-click HTML download & PDF print—zero local TCP ports required).",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "AGY Preview",
    "views": [
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "AGY Preview"
      },
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "AGY Preview"
      }
    ]
  }
}
