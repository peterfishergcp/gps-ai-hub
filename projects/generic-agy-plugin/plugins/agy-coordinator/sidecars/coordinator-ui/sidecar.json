{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "Clawy",
  "description": "Multi-Agent Command Center & Gemini Live Voice Hub (Clawy) \u2014 animated 3D Brown Bear perch, Kore voice, side-by-side agent pop-outs, and Group -> Goal -> Task sprints.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Clawy",
    "views": [
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Clawy"
      },
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Clawy"
      }
    ]
  }
}
