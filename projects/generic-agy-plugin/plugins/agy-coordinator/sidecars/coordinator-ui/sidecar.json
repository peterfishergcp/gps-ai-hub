{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "AGY Coordinator",
  "description": "Multi-agent coordinator with an animated Clawy mascot perch, live Worker board, 2-level Group -> Goal -> Task tracker, editable IDENTITY.md/SOUL.md, and Dual-Mode Voice (Browser Web Speech + Gemini Live).",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "AGY Coordinator",
    "views": [
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "AGY Coordinator"
      },
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "AGY Coordinator"
      }
    ]
  }
}
