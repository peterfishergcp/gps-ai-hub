{
  "command": "node",
  "args": [
    "main.mjs",
    "--agy-sidecar=twin-vault-ui"
  ],
  "restart_policy": "always",
  "display_name": "My Hub",
  "description": "Zero-footprint Antigravity My Hub workspace: ask anything, catch up on AI Inbox Action Items and topics, track TokenEconomics, connect built-in Google Workspace apps via Customizations, and customize your voice and memory files.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "My Hub",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "My Hub"
      },
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "My Hub",
        "title_bar_style": "SIDECAR_UI_TITLE_BAR_STYLE_HIDDEN"
      }
    ]
  }
}
