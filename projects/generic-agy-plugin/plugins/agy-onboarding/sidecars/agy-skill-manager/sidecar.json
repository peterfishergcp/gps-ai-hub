{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "AGY Skills & Connectors",
  "description": "Interactive toggle control panel for Public Sector Antigravity skills and Federated Gemini Enterprise instance settings.",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "AGY Skills",
    "views": [
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "AGY Skills"
      },
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "AGY Skills"
      }
    ]
  }
}
