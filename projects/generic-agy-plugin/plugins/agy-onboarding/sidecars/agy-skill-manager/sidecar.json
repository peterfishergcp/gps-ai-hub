{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "Skills",
  "description": "Clean Antigravity skill manager: run 1-click seed prompts, save personal skill copies, toggle categories, and configure Federated Gemini Enterprise connectors.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Skills",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Skills"
      },
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Skills",
        "title_bar_style": "SIDECAR_UI_TITLE_BAR_STYLE_HIDDEN"
      }
    ]
  }
}
