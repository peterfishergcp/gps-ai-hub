{
  "command": "node",
  "args": [
    "main.mjs",
    "--agy-sidecar=agy-skill-manager"
  ],
  "restart_policy": "always",
  "display_name": "Skills",
  "description": "Clean Antigravity & AI Inbox skill manager: toggle 36 curated skills or categories (including Personal Skills), ask Clawy in plain English, and sync <1s SHA-256 updates.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Skills",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Skills"
      },
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Skills",
        "title_bar_style": "SIDECAR_UI_TITLE_BAR_STYLE_HIDDEN"
      }
    ]
  }
}
