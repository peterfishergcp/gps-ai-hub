  "changelog": [
    {
      "version": "1.5.0",
      "date": "2026-11-20",
      "highlights": [
        "Removed all 'Twin' and 'GTD' jargon across UI, slash commands (/my-voice, /memory, /meeting-notes, /meeting-prep, /followup-plan, /swarm-prep, /weekly-impact, /automations), manifests, and docs, with seamless migration from ~/antigravity-twin/memory/gtd_board.md to ~/my-antigravity/memory/action_items.md.",
        "Redesigned 'Action Items' (replacing GTD Board) with the Gmail AI Inbox look & feel: 'Suggested to-dos' with sky-blue Reply / Open pills + scallop wave divider + 3-column 'Topics to catch up on' cards.",
        "Removed the 'Markdown Files' tab and added a clean top-right 'Customize' sliders icon button combining Role/Profile setup with Voice & Memory file customization."
      ]
    },
    {
      "version": "1.4.0",
      "date": "2026-11-20",
      "highlights": [
        "Added live hoverable token usage meter (in | out | thinking) across My Antigravity, Skills, and Preview panels, plus /token-usage and /orchestrator-guide (expanding the suite to 39 slash-command skills)."
      ]
    },
    {
      "version": "1.0.0",
      "date": "2026-11-19",
      "highlights": [
        "Initial generic Public Sector release across modular plugins, slash-command skills (including the 7 Government Services public_sector skills), and serverless UI sidecars (Skills & Preview).",
        "Zero-install Gemini Enterprise (GE) Federated Connector Bridge (agy-ge-bridge) running on Antigravity's built-in agy-node runtime for Outlook, SharePoint, OneDrive, Teams, Gmail, Drive, and GitHub.",
        "SHA-256 per-skill incremental updater (incremental-sync.mjs + 1-click 'Sync Git Updates' & per-skill refresh buttons inside Skills) so cohorts update changed files in <1s without full re-installs.",
        "100% serverless Side-Pane visual previews for /agy-dashboard, /slides, and /doc-design with 1-click standalone HTML download and zero local TCP port listeners."
      ]
    }
  ],
