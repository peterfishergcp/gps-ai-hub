  "changelog": [
    {
      "version": "1.1.1",
      "date": "2026-11-20",
      "highlights": [
        "Added 1-Click 'Skills' Seed Prompt tab inside Twin Vault (right in front of Markdown Files) covering all 37 installed skills across 9 categories, plus clickable 1-click seed prompt pills in AGY Skills."
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-11-20",
      "highlights": [
        "Integrated the consolidated agy-second-brain plugin (8 net-new non-duplicate skills, 4 parallel subagents, and the Twin Vault side-pane UI) plus opt-in agy-twin-automations (disabled by default; 4 scheduled cron workflows), expanding the suite to 8 plugins and 37 slash-command skills across 9 AGY Skills categories.",
        "Upgraded /agy-onboard, /daily-brief, and /digital-twin in agy-onboarding to be Second-Brain Vault-aware (~/antigravity-twin/memory/) with zero command duplication.",
        "Added deterministic zero-Node inline regex fallback to /outbound-scrub and native edit_file timezone configuration to /twin-automations for locked-down corporate laptops."
      ]
    },
    {
      "version": "1.0.0",
      "date": "2026-11-19",
      "highlights": [
        "Initial generic Public Sector release across all 6 modular plugins, 28 slash-command skills across 7 categories (including the 7 Government Services public_sector skills), and 2 serverless UI sidecars (AGY Skills & AGY Preview).",
        "Zero-install Gemini Enterprise (GE) Federated Connector Bridge (agy-ge-bridge) running on Antigravity's built-in agy-node runtime for Outlook, SharePoint, OneDrive, Teams, Gmail, Drive, and GitHub.",
        "SHA-256 per-skill incremental updater (incremental-sync.mjs + 1-click 'Sync Git Updates' & per-skill refresh buttons inside AGY Skills) so cohorts update changed files in <1s without full re-installs.",
        "100% serverless Side-Pane visual previews for /agy-dashboard, /slides, and /doc-design with 1-click standalone HTML download and zero local TCP port listeners."
      ]
    }
  ],
