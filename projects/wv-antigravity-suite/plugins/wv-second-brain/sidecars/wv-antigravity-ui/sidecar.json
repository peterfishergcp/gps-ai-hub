{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "WV Antigravity",
  "description": "Zero-footprint West Virginia Antigravity workspace: ask anything, catch up on AI Inbox Action Items and topics, launch 1-click WV workflows and skills, save personal skill copies, and customize your voice and memory files.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "WV Antigravity",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "WV Antigravity"
      },
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "WV Antigravity",
        "title_bar_style": "SIDECAR_UI_TITLE_BAR_STYLE_HIDDEN"
      }
    ]
  }
}
