{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "WV Preview",
  "description": "Serverless West Virginia visual preview panel for Dashboards, 16:9 Slide Decks, Branded Docs, and Interactive HTML Artifacts\u2014with automatic artifact capture, Print-to-PDF, and 1-click HTML download (zero local TCP ports).",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "WV Preview",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "WV Preview"
      },
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "WV Preview",
        "title_bar_style": "SIDECAR_UI_TITLE_BAR_STYLE_HIDDEN"
      }
    ]
  }
}
