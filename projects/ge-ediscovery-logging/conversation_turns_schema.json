  {
    "name": "model_name",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Model used to serve the turn if logged in Cloud Logging"
  },
  {
    "name": "session_transcript_gcs_uri",
    "type": "STRING",
    "mode": "NULLABLE",
