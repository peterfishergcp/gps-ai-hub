  {
    "name": "session_transcript_console_url",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Authenticated Cloud Console URL for the session transcript JSON"
  },
  {
    "name": "files",
    "type": "RECORD",
    "mode": "REPEATED",
    "description": "User-uploaded (USER_PROVIDED) and AI-generated (AI_GENERATED) files archived to GCS",
    "fields": [
      {
        "name": "file_id",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "file_source",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "file_name",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "mime_type",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "byte_size",
        "type": "INTEGER",
        "mode": "NULLABLE"
      },
      {
        "name": "sha256",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "crc32c",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "gcs_uri",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "console_url",
        "type": "STRING",
        "mode": "NULLABLE"
      }
    ]
  },
  {
    "name": "event_timestamp",
    "type": "TIMESTAMP",
    "mode": "NULLABLE",
    "description": "Timestamp of the turn or session activity"
  },
  {
    "name": "harvested_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "Timestamp when ge_harvest.py archived this turn"
