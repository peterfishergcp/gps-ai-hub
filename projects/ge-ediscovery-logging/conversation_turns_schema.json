    "mode": "REQUIRED",
    "description": "Discovery Engine Session ID"
  },
  {
    "name": "turn_index",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "1-based index of the conversation turn within the session"
  },
  {
    "name": "query_id",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Unique queryId for this turn"
  },
  {
    "name": "assist_answer_id",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "AssistAnswer resource ID for this turn"
  },
  {
    "name": "engine_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Gemini Enterprise Engine/App ID"
  },
  {
    "name": "location",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Discovery Engine location (us, global, eu)"
  },
  {
    "name": "user_iam_principal",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Authenticated userIamPrincipal (Workforce Pool subject or Workspace email)"
  },
  {
    "name": "session_display_name",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Session display title"
  },
  {
    "name": "prompt_text",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Full untruncated user prompt text"
  },
  {
    "name": "response_text",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Full untruncated user-visible assistant response (thought=true stripped)"
  },
  {
    "name": "thought_text",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Internal model reasoning / thought chain (thought=true)"
