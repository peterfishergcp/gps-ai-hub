# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Per-user ACL enforcement (fail-closed default: requires end-user OAuth token in ToolContext state)
REQUIRE_USER_OAUTH_TOKEN=true

# Cloud Run / HTTP Caller Authentication & RBAC
# IAP_AUDIENCE=/projects/YOUR_PROJECT_NUMBER/global/backendServices/YOUR_BACKEND_SERVICE_ID
# EXPECTED_OIDC_AUDIENCE=your-oauth-client-id.apps.googleusercontent.com
# ALLOWED_CALLER_EMAILS=reviewer@your-domain.gov
# ALLOWED_CALLER_DOMAINS=your-domain.gov

# Optional: Discovery Engine Google Sites Data Store configuration
# GOOGLE_SITES_PROJECT_NUMBER=your-gcp-project-number
# GOOGLE_SITES_DATASTORE_ID=your-google-sites-datastore-id
# GOOGLE_SITES_FALLBACK_ENGINES=your-fallback-engine-id

# Alternatively, for Gemini API via Google AI Studio,
# comment out the Vertex AI lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
