# Google Cloud Project & Workforce Identity Federation Configuration
export GCP_PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
export WORKFORCE_POOL_ID="<YOUR_WORKFORCE_POOL_ID>"
export ARCHIVER_PROVIDER_ID="ediscovery-archiver"

# Cloud Storage & BigQuery Archive Configuration
export GCS_BUCKET_NAME="${GCP_PROJECT_ID}-ge-ediscovery"
export BQ_DATASET="ge_ediscovery"
export BQ_TABLE="conversation_turns"
export LOGGING_SINK_NAME="ge-ediscovery-bq-sink"

# Optional: Target Engine & Test User Subject for End-to-End Verification (test_ge_ediscovery_e2e.py)
export GE_LOCATION="us"
export GE_ENGINE_ID="<YOUR_GE_ENGINE_ID>"
export TEST_WIF_USER_SUBJECT="<YOUR_TEST_WIF_USER_SUBJECT>"
