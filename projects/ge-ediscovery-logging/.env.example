# Google Cloud Project & Workforce Identity Federation Configuration
export GCP_PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
export WORKFORCE_POOL_ID="<YOUR_WORKFORCE_POOL_ID>"
export ARCHIVER_PROVIDER_ID="ediscovery-archiver"

# Cloud KMS Asymmetric Signing Configuration (Zero Private Key on Disk)
export KMS_LOCATION="us-central1"
export KMS_KEYRING="ge-ediscovery-kr"
export KMS_KEY="ediscovery-archiver-jwt-key"

# Cloud Storage & BigQuery Archive Configuration
export GCS_BUCKET_NAME="${GCP_PROJECT_ID}-ge-ediscovery"
export BQ_DATASET="ge_ediscovery"
export BQ_TABLE="conversation_turns"
export LOGGING_SINK_NAME="ge-ediscovery-bq-sink"

# Real-Time Cloud Run Service, Review Portal & Pub/Sub Configuration
export CLOUD_RUN_REGION="us-central1"
export CLOUD_RUN_SERVICE="ge-ediscovery-harvester"
export PORTAL_SERVICE_NAME="ge-ediscovery-portal"
export PORTAL_REVIEWER_EMAIL="<YOUR_COMPLIANCE_REVIEWER_EMAIL>"
export ALLOWED_REVIEWER_EMAILS="<YOUR_COMPLIANCE_REVIEWER_EMAIL>"
export ALLOWED_REVIEWER_DOMAINS=""
export IAP_AUDIENCE=""
export EXPECTED_OAUTH_CLIENT_ID=""

# Optional: WIF Subject Hardening (Denylist privileged Org/IAM Admins & pin allowed domains)
export ARCHIVER_DENIED_SUBJECTS=""
export ARCHIVER_ALLOWED_SUBJECT_DOMAINS=""

# Optional: Keyless Google Workspace Domain-Wide Delegation Fallback (only needed for non-WIF Workspace engines)
export DWD_SA_EMAIL=""

# Optional: Target Engine & Test User Subject for End-to-End Verification (test_ge_ediscovery_e2e.py)
export GE_LOCATION="us"
export GE_ENGINE_ID="<YOUR_GE_ENGINE_ID>"
export TEST_WIF_USER_SUBJECT="<YOUR_TEST_WIF_USER_SUBJECT>"

# Optional: Microsoft Purview eDiscovery & DSPM for AI Integration (purview_connector.py)
# NOTE: Pass MS_CLIENT_SECRET via Google Cloud Secret Manager (--ms-client-secret-name) in production.
export MS_TENANT_ID=""
export MS_CLIENT_ID=""
export MS_CLIENT_SECRET=""
export PURVIEW_COMPLIANCE_JOURNAL_UPN=""
export PURVIEW_HIDE_FOLDER="true"
export PURVIEW_FAIL_CLOSED="true"
export PURVIEW_EDISCOVERY_FOLDER="Gemini Enterprise eDiscovery"
export PURVIEW_MESSAGE_CLASS="IPM.Note.Google.GeminiEnterprise"


