{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "My Antigravity",
  "description": "Clean personal Antigravity workspace: ask anything, launch 1-click workflows and skills, save personal skill copies, track GTD tasks and initiatives, and edit Markdown memory files.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "My Antigravity",
    "views": [
      {
        "path": "/?entrypoint=sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "My Antigravity"
      },
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "My Antigravity"
      }
    ]
  }
}
