# Keyless Vertex AI Application Default Credentials (ADC) configuration
# Copy to ./briefing-coach/.env (automatically handled by AGENTS.md Step 2).
# No API keys are stored on disk or passed in chat.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
AGENT_MODEL=gemini-3.8-flash
